# ====================================================================
# AeroHarvest Australia — Production Environment Variables
# Governed by Master Project Governance Prompt v004 & Blueprint v002
# ====================================================================

# 1. Shopify Commerce Integration
VITE_SHOPIFY_STORE_DOMAIN=aeroharvest.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token_here
VITE_SHOPIFY_BUY_BUTTON_ENABLED=false

# 2. Shopify Hardware Product & Variant IDs (B2C)
# 5-Section Compact Tower
VITE_SHOPIFY_VARIANT_5_BASE=gid://shopify/ProductVariant/5_base_variant_id
VITE_SHOPIFY_VARIANT_5_KIT=gid://shopify/ProductVariant/5_kit_variant_id

# 7-Section Standard Tower (Flagship)
VITE_SHOPIFY_VARIANT_7_BASE=gid://shopify/ProductVariant/7_base_variant_id
VITE_SHOPIFY_VARIANT_7_KIT=gid://shopify/ProductVariant/7_kit_variant_id

# 11-Section Family Powerhouse Tower
VITE_SHOPIFY_VARIANT_11_BASE=gid://shopify/ProductVariant/11_base_variant_id
VITE_SHOPIFY_VARIANT_11_KIT=gid://shopify/ProductVariant/11_kit_variant_id

# Add-on Accessories
VITE_SHOPIFY_VARIANT_ADDON_LED=gid://shopify/ProductVariant/addon_led_variant_id
VITE_SHOPIFY_VARIANT_ADDON_TRELLIS=gid://shopify/ProductVariant/addon_trellis_variant_id

# 3. B2B Commercial Onboarding & Webhook Ingestion
# Supply a webhook URL (Zapier, Make, HubSpot, Klaviyo, Slack, or custom API)
VITE_B2B_WEBHOOK_URL=
# Direct commercial operations notification email
VITE_B2B_LEAD_EMAIL=commercial@aeroharvest.com.au
